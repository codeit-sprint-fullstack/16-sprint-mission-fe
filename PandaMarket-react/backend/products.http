
// ======================================================================
// backend/products.http
// POST + GET 테스트를 한 파일에서 하기
// ======================================================================


// ======================================================================
// 1. 상품 등록 테스트
// ======================================================================

### 상품 등록

POST http://localhost:3000/api/products
Content-Type: application/json

{
  "name": "맥북 에어",
  "description": "상태 좋습니다.",
  "price": 900000,
  "tags": ["전자제품", "노트북"]
}


// ↑ 여기까지는 아까 했던 POST 테스트
//
// 성공하면 MongoDB에
// "맥북 에어" 상품이 하나 저장됨.


// ======================================================================
// 2. 전체 상품 목록 GET 테스트
// ======================================================================

### 상품 목록 조회

GET http://localhost:3000/api/products


// GET 위쪽에 나타나는:
//
// send
//
// 를 클릭하면 됨.
//
// 흐름:
//
// GET /api/products
//       ↓
// Express
//       ↓
// MongoDB에서 상품 찾기
//       ↓
// 상품 목록 응답


// 네 GET API를 list + totalCount 형태로 만들었다면:
//
// {
//   "list": [
//     {
//       "id": 1,
//       "name": "맥북 에어",
//       "description": "상태 좋습니다.",
//       "price": 900000,
//       "tags": ["전자제품", "노트북"]
//     }
//   ],
//   "totalCount": 1
// }
//
// 이런 식으로 나오면 성공 ✅


// ======================================================================
// 3. 페이지네이션 테스트
// ======================================================================

### 상품 목록 - 1페이지

GET http://localhost:3000/api/products?page=1&pageSize=10


// 여기서:
//
// ?page=1&pageSize=10
//
// 이 부분은 query string.
//
// 뜻:
//
// page=1
// → 1페이지 주세요.
//
// pageSize=10
// → 한 페이지에 상품 10개 주세요.


// 그림으로:
//
// /api/products?page=1&pageSize=10
//              │      │
//              │      └── 한 페이지에 10개
//              │
//              └───────── 1페이지


// 서버에서는:
//
// req.query.page
// → "1"
//
// req.query.pageSize
// → "10"
//
// 이렇게 받을 수 있음.


// ======================================================================
// 4. 검색 테스트
// ======================================================================

### 상품 검색

GET http://localhost:3000/api/products?keyword=맥북


// 뜻:
//
// "상품 중에서 '맥북'이라는 검색어가 들어간 상품 찾아줘"
//
//
// 서버에서는:
//
// req.query.keyword
//
// 결과:
//
// "맥북"


// 예를 들어 MongoDB에:
//
// 맥북 에어
// 아이폰
// 맥북 프로
//
// 가 있다면:
//
// keyword=맥북
//
// 검색 결과:
//
// 맥북 에어
// 맥북 프로
//
// 가 나오는 식.


// ======================================================================
// 5. 페이지 + 검색을 같이 테스트할 수도 있음
// ======================================================================

### 검색 + 페이지네이션

GET http://localhost:3000/api/products?page=1&pageSize=10&keyword=맥북


// 뜻:
//
// keyword=맥북
//      ↓
// 맥북 관련 상품을 찾고
//      ↓
// page=1
//      ↓
// 첫 페이지를
//      ↓
// pageSize=10
//      ↓
// 최대 10개 가져오기



### 상품 목록 조회
GET http://localhost:3000/api/products


### 상품 하나 조회
GET http://localhost:3000/api/products/1


### 상품 수정
PATCH http://localhost:3000/api/products/1
Content-Type: application/json

{
  "price": 800000
}


### 상품 삭제
DELETE http://localhost:3000/api/products/1